# Copy to .env and adjust. Every value below is optional; the defaults in
# conciergeagent/core/config.py are safe for local development.

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true emits one JSON object per log line (for log shippers);
# false emits human-readable lines.
JSON_LOGS=true

# Comma-separated CORS allowlist. The API sends credentials, so a wildcard is
# deliberately NOT supported here - list the exact origins that may call it.
ALLOWED_ORIGINS=http://127.0.0.1:8005,http://localhost:8005

# Serve Prometheus metrics at /metrics
METRICS_ENABLED=true

# --- Optional LLM narration --------------------------------------------
# The deterministic reply is always computed first; these variables only
# control whether it also gets rendered in natural language by a model
# before it reaches the customer. Leave LLM_API_KEY unset and the platform
# runs fully deterministically - the default, and what the public demo does.
#
# Any OpenAI-compatible /chat/completions endpoint works. Groq's free tier
# (https://console.groq.com/keys) is the default because it needs no card
# and serves Llama 3.3 70B fast enough for a live concierge SLA; swap in
# Cerebras, OpenRouter, Together, or a local Ollama server (with
# LLM_BASE_URL=http://localhost:11434/v1) without touching any code.
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8
