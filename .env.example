# Copy to .env and adjust. Every value below is optional; the defaults in
# conciergeagent/core/config.py are safe for local development.

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true emits one JSON object per log line (for log shippers);
# false emits human-readable lines.
JSON_LOGS=true

# Comma-separated CORS allowlist. The API sends credentials, so a wildcard is
# deliberately NOT supported here - list the exact origins that may call it.
ALLOWED_ORIGINS=http://127.0.0.1:8005,http://localhost:8005

# Serve Prometheus metrics at /metrics
METRICS_ENABLED=true
